# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"


# Product Key backend API base URL (Express server running on port 5000 by default)
VITE_PRODUCT_KEY_API_URL="http://localhost:5000"

# Calendar backend API base URL (Express server running on port 5001 by default)
# This MUST point to the root domain and end WITHOUT a trailing slash
VITE_CALENDAR_API_URL="https://resolve-pm.onrender.com"
