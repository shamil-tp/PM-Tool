# ============================================================
# PM-Tool — Standalone Docker Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# All services run locally via Docker — no external Supabase needed.
# ============================================================

# --- FRONTEND VARIABLES ---

# The URL for the Calendar Backend API.
# IMPORTANT: This must be the PUBLIC IP or domain of your server,
# because the frontend runs in the user's browser!
# Example: http://192.168.1.100:5001 or https://api.yourdomain.com:5001
VITE_CALENDAR_API_URL=http://your-server-ip:5001

# --- BACKEND VARIABLES ---

# Google OAuth credentials for Calendar integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# IMPORTANT: Must match the public IP or domain of the calendar backend
REDIRECT_URI=http://your-server-ip:5001/api/calendar/oauth2callback

# JWT Secret for backend authentication (change this to a long random string!)
JWT_SECRET=a_very_long_secure_random_string

# --- DATABASE VARIABLES ---

# PostgreSQL password (used by both the DB container and core-backend)
POSTGRES_PASSWORD=mysecretpassword

# MongoDB Connection String (uses the local container)
DB=mongodb://mongodb:27017/pm-tool
