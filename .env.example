# --- FRONTEND VARIABLES ---
# The URL to your Supabase project (from Supabase dashboard)
VITE_SUPABASE_URL=https://your-supabase-url.supabase.co
# The Anon Key for your Supabase project (from Supabase dashboard)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# The URL for the Calendar Backend API. 
# IMPORTANT: This must be the PUBLIC IP or domain of your server, because the frontend runs in the user's browser!
# Example: http://192.168.1.100:5001 or https://api.yourdomain.com:5001
VITE_CALENDAR_API_URL=http://your-server-ip:5001

# --- BACKEND VARIABLES ---
# Google OAuth credentials for Calendar integration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# IMPORTANT: Must match the public IP or domain of the calendar backend
REDIRECT_URI=http://your-server-ip:5001/api/calendar/oauth2callback

# JWT Secret for backend authentication
JWT_SECRET=a_very_long_secure_random_string

# MongoDB Connection String (Atlas or Local)
# To use the local mongodb container, set this to: mongodb://mongodb:27017/pm-tool
DB=mongodb+srv://shamil:urcx5298@mysnapgram.zq2yd.mongodb.net/pm-tool
